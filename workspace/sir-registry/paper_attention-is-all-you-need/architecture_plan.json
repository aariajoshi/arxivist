  "tensor_flows": [
    {
      "name": "Transformer Forward Pass",
      "input": {
        "name": "src_tokens",
        "shape": "[B, T_src]",
        "dtype": "int64"
      },
      "output": {
        "name": "logits",
        "shape": "[B, T_tgt, vocab_size]",
        "dtype": "float32"
      },
      "steps": [
        "src_emb = embedding(src_tokens) * sqrt(d_model) + positional_encoding",
        "memory = encoder(src_emb, src_mask)",
        "tgt_emb = embedding(tgt_tokens) * sqrt(d_model) + positional_encoding",
        "decoder_out = decoder(tgt_emb, memory, src_mask, tgt_mask)",
        "logits = linear_out(decoder_out)"
      ]
    },
    {
      "name": "Multi-Head Attention",
      "input": {
        "name": "query, key, value",
        "shape": "[B, T, d_model]",
        "dtype": "float32"
      },
      "output": {
        "name": "attn_out",
        "shape": "[B, T, d_model]",
        "dtype": "float32"
      },
      "steps": [
        "Q = query @ W_q, K = key @ W_k, V = value @ W_v  -> [B, T, d_model]",
        "Reshape Q, K, V to [B, h, T, d_k] (and d_v for V)",
        "scores = Q @ K^T / sqrt(d_k)",
        "scores = apply_mask(scores, mask)",
        "attn = softmax(scores) @ V  -> [B, h, T, d_v]",
        "Reshape attn to [B, T, d_model]",
        "attn_out = attn @ W_o"
      ]
    }
  ],
