  "tensor_flows": [
    {
      "name": "OPANN Forward Pass",
      "input": {"name": "x", "shape": "[B, K]", "dtype": "float32"},
      "output": {"name": "class_probs", "shape": "[B, J]", "dtype": "float32"},
      "steps": [
        "x: [B, K] — standardised features",
        "h = activation(x @ W1.T + b1)   → [B, Q]  (hidden layer; activation hyperparameter-searched)",
        "f = h @ v + c                   → [B, 1]  (latent index f(x_i, theta))",
        "cuts = CuttingPoints()           → [J-1]  (strictly ordered via softplus+cumsum)",
        "phi_upper = Phi(cuts - f)        → [B, J-1]  (standard normal CDF)",
        "class_probs = phi_upper[:,1:] - phi_upper[:,:-1]  → [B, J]  (boundary terms: Phi(-inf)=0, Phi(+inf)=1)",
        "return class_probs: [B, J]"
      ]
    },
    {
      "name": "HOPANN Forward Pass",
      "input": {"name": "x_and_z", "shape": "[B, K] and [B, K]", "dtype": "float32"},
      "output": {"name": "class_probs", "shape": "[B, J]", "dtype": "float32"},
      "steps": [
        "x: [B, K], z: [B, K]  (z=x by default — TODO: verify from paper)",
        "h_mean = activation(x @ W1.T + b1)   → [B, Q]",
        "f = h_mean @ v + c                   → [B, 1]  (latent index)",
        "h_var = activation(z @ W1_var.T + b1_var)   → [B, Q_z]  (variance hidden; TODO: confirm from paper)",
        "log_sigma = h_var @ v_var + c_var    → [B, 1]",
        "sigma = exp(log_sigma)               → [B, 1]  (positive per-sample std)",
        "cuts = CuttingPoints()               → [J-1]",
        "scaled = (cuts - f) / sigma          → [B, J-1]",
        "phi_upper = Phi(scaled)              → [B, J-1]",
        "class_probs = phi_upper[:,1:] - phi_upper[:,:-1]  → [B, J]",
        "return class_probs: [B, J]"
      ]
    },
    {
      "name": "CuttingPoints Reparameterisation",
      "input": {"name": "raw_params", "shape": "[J-1]", "dtype": "float32"},
      "output": {"name": "ordered_cuts", "shape": "[J-1]", "dtype": "float32"},
      "steps": [
        "raw_params[0] → c_1 (unconstrained)",
        "increments = softplus(raw_params[1:])   → [J-2]  (all > 0)",
        "c_k = c_1 + cumsum(increments)          → [J-2]  (strictly ordered)",
        "return [c_1, c_2, ..., c_{J-1}]"
      ]
    },
    {
      "name": "OrderedProbitNLL",
      "input": {"name": "probs + targets", "shape": "[B, J] + [B]", "dtype": "float32 + long"},
      "output": {"name": "loss", "shape": "[]", "dtype": "float32"},
      "steps": [
        "log_probs = log(clamp(probs, min=1e-7))   → [B, J]",
        "selected = gather(log_probs, targets)       → [B, 1]",
        "nll = -mean(selected)                       → scalar",
        "return nll"
      ]
    }
  ],
